# ─── Aviel Tax System — Environment Variables ───────────────────────────────
# Copy this file to .env.local (Vite dev) and set all variables in Vercel too.

# ── Poe API (AI Report Generation) ──────────────────────────────────────────
# Required for /api/report.js — generates the AI tax health analysis using Poe
POE_API_KEY=sk-poe-tvx1ZF2CyHlzGkasqh4ewf-Hvc1KOKe290XZhjapEdc
POE_BASE_URL=https://api.poe.com/v1

# ── Resend (Transactional Email) ──────────────────────────────────────────────
# Required for /api/email.js — sends the tax report to the client
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The "from" address — must be a verified domain in Resend
FROM_EMAIL=Aviel Alpha <hello@aasecretaries.com.ng>

# Admin BCC address — receives a copy of every email sent
ADMIN_EMAIL=sprqsm001@gmail.com

# ── Google Sheets Webhook ─────────────────────────────────────────────────────
# Required for /api/submit.js — stores submissions in Google Sheets
# Create via Google Apps Script → Deploy as Web App
GOOGLE_SHEET_WEBHOOK=https://script.google.com/macros/s/XXXXX/exec

# ── Supabase (Auth + Database) ────────────────────────────────────────────────
# Required for user authentication (admin dashboard login)
# Get from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# ── Upstash Redis (Persistent Rate Limiting) ──────────────────────────────────
# Optional — falls back to in-memory Map if not set
# Get from: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://XXXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origin for API requests (your production domain)
ALLOWED_ORIGIN=https://aasecretaries.com.ng

# ── Feature Flags (Optional) ─────────────────────────────────────────────────
# Set to 'true' to enable features in development
VITE_ENABLE_AUTH=true
VITE_ENABLE_PDF_DOWNLOAD=true
